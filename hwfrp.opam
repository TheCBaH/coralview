# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Functional reactive models of hardware over waveform traces"
description:
  "A synchronous dataflow engine that samples VCD and FST waveforms, read with ovcd, per clock domain and evaluates signal, event and state-machine graphs over them."
maintainer: ["Vladimir Silyaev"]
authors: ["Vladimir Silyaev"]
license: "MIT"
homepage: "https://github.com/TheCBaH/coralview"
bug-reports: "https://github.com/TheCBaH/coralview/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "4.14"}
  "ovcd"
  "ppx_expect" {with-test}
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/TheCBaH/coralview.git"
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-generated"
x-ai-provider: "Anthropic"
# None of these are in opam-repository yet; pin-depends is not transitive.
pin-depends: [
  ["unlz4.dev" "git+https://github.com/TheCBaH/ocaml-unlz4.git#f5446abf9a4ce4beb92b02ee958f345a6c8171bd"]
  ["fst.dev" "git+https://github.com/TheCBaH/ocaml-fst.git#e709ec7f63b1ce092b84ae9edffabb54370fc4cf"]
  ["ovcd.dev" "git+https://github.com/TheCBaH/ovcd.git#2c1b9c613efa92b664f6112747780212b9e5747e"]
]
