// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "coralview devcontainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "ghcr.io/devcontainers/features/sshd:1": {},
        "ghcr.io/thecbah/ocaml-features/ocaml:1": {
            // CI sets OCAML_VERSION per matrix leg.
            "version": "${localEnv:OCAML_VERSION:4.14.4}",
            // Same commits as coralview.opam's pin-depends, so make deps finds them installed.
            "pin-packages": "zipc git+https://github.com/dbuenzli/zipc.git#4335e845388b05b9161c8fd58b4ef4363819e43b,unlz4 git+https://github.com/TheCBaH/ocaml-unlz4.git#f5446abf9a4ce4beb92b02ee958f345a6c8171bd,fst git+https://github.com/TheCBaH/ocaml-fst.git#32d68870539fb7422c86e5d8fc62db8568b173a7,ovcd git+https://github.com/TheCBaH/ovcd.git#9e6d53af48db166d095a506ed350682c7683b48b,err_trace git+https://github.com/TheCBaH/err_trace.git#1c7a6ba94c81c70008c594c709e7d37feb38f435,elf git+https://github.com/TheCBaH/ocaml-elf.git#bc00b700fe69710af5887e7d4c920a2294c73522",
            "packages": "bytesrw cmdliner dune elf err_trace fmt jsont menhir ocamlformat#0.28.1 ovcd ppx_expect ppx_inline_test qcheck-core re"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "RIVET_EXTERNAL_DEPS": "true"
    },
    // vendor/rivet is needed to build; its own submodules are not (RIVET_EXTERNAL_DEPS).
    "postCreateCommand": "sudo .devcontainer/fix-opam-owner.sh $(id -u) $(id -g) && git config --global --add safe.directory '*' && git submodule update --init && make deps",
    "waitFor": "postCreateCommand"
}
