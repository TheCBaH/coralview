// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "coralview devcontainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "ghcr.io/devcontainers/features/sshd:1": {},
        "ghcr.io/thecbah/ocaml-features/ocaml:1": {
            // CI sets OCAML_VERSION per matrix leg.
            "version": "${localEnv:OCAML_VERSION:4.14.4}",
            // Same commits as coralview.opam's pin-depends, so make deps finds them installed.
            "pin-packages": "zipc git+https://github.com/dbuenzli/zipc.git#4335e845388b05b9161c8fd58b4ef4363819e43b,unlz4 git+https://github.com/TheCBaH/ocaml-unlz4.git#8db02229baf5bc2f45514618bfd2e07b0708bcf5,fst git+https://github.com/TheCBaH/ocaml-fst.git#83ff8b97cd7e889c883bc3519e0b00ecd51c8c63,ovcd git+https://github.com/TheCBaH/ovcd.git#d2281b52f624e348809b9ae4c8af1d84439b63a2,err_trace git+https://github.com/TheCBaH/err_trace.git#d7765040d9cc3d024522e204866ac00ff261c4e8,elf git+https://github.com/TheCBaH/ocaml-elf.git#bc00b700fe69710af5887e7d4c920a2294c73522",
            "packages": "bytesrw cmdliner dune elf err_trace fmt jsont menhir ocamlformat#0.28.1 ovcd ppx_expect ppx_inline_test qcheck-core re"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "RIVET_EXTERNAL_DEPS": "true"
    },
    // vendor/rivet is needed to build; its own submodules are not (RIVET_EXTERNAL_DEPS).
    "postCreateCommand": "sudo .devcontainer/fix-opam-owner.sh $(id -u) $(id -g) && git config --global --add safe.directory '*' && git submodule update --init && make deps",
    "waitFor": "postCreateCommand"
}
