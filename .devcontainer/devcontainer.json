// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "coralview devcontainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "ghcr.io/devcontainers/features/sshd:1": {},
        "ghcr.io/thecbah/ocaml-features/ocaml:1": {
            // CI sets OCAML_VERSION per matrix leg.
            "version": "${localEnv:OCAML_VERSION:4.14.4}",
            // Same commits as coralview.opam's pin-depends, so make deps finds them installed.
            "pin-packages": "zipc git+https://github.com/dbuenzli/zipc.git#4335e845388b05b9161c8fd58b4ef4363819e43b,unlz4 git+https://github.com/TheCBaH/ocaml-unlz4.git#1b79f18cb5c7c76cb2e29a329017d78884423feb,fst git+https://github.com/TheCBaH/ocaml-fst.git#0d6797ad218463775e852f86c81b793924c8d4ab,ovcd git+https://github.com/TheCBaH/ovcd.git#48a850d6fe8b3573b6ae8427ebf6661099b77c47,err_trace git+https://github.com/TheCBaH/err_trace.git#8138a417b452e55483028df851cb562fbf175eed,elf git+https://github.com/TheCBaH/ocaml-elf.git#23fdf5d32a5de2e2f39134b93143a659e38352c1",
            "packages": "bytesrw cmdliner dune elf err_trace fmt jsont menhir ocamlformat#0.29.0 ovcd ppx_expect ppx_inline_test qcheck-core re",
            "ocaml-version-overrides": "dune#3.24.2@5.4.*"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "RIVET_EXTERNAL_DEPS": "true"
    },
    // vendor/rivet is needed to build; its own submodules are not (RIVET_EXTERNAL_DEPS).
    "postCreateCommand": "sudo .devcontainer/fix-opam-owner.sh $(id -u) $(id -g) && git config --global --add safe.directory '*' && git submodule update --init && make deps",
    "waitFor": "postCreateCommand"
}
