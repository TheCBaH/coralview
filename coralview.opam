opam-version: "2.0"
synopsis: "Coral NPU tooling: simulator runner and trace observability"
description:
  "Runs the Coral NPU simulators, reads their FST waveforms with ovcd and decodes the executed instructions with Rivet."
maintainer: ["Vladimir Silyaev"]
authors: ["Vladimir Silyaev"]
license: "MIT"
homepage: "https://github.com/TheCBaH/coralview"
bug-reports: "https://github.com/TheCBaH/coralview/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "4.14"}
  "hwfrp"
  "ovcd"
  "fst"
  "err_trace"
  "fmt"
  "menhir"
  "jsont" {>= "0.4.0"}
  "bytesrw"
  "cmdliner" {>= "1.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/TheCBaH/coralview.git"
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-generated"
x-ai-provider: "Anthropic"
